---
/**
 * A single furniture piece in the grid.
 *
 * Bilingual: the Chinese title is primary, the English title sits beneath it
 * in a smaller, dimmer weight. Same for the description.
 *
 * Image strategy:
 *  - <Picture> emits AVIF + WebP with automatic fallback.
 *  - `widths` generates a real srcset, so phones fetch a small file.
 *  - `sizes` tells the browser which breakpoint maps to which width.
 *  - width/height come from the source file, so layout never shifts.
 *  - Only the first item in each section is eager; the rest lazy-load.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'work'>;
  priority?: boolean;
  index: number;
  featured?: boolean;
}

const { item, priority = false, index, featured = false } = Astro.props;
const {
  title,
  titleEn,
  year,
  materials,
  materialsEn,
  dimensions,
  description,
  descriptionEn,
  cover,
  gallery,
} = item.data;

const lead = cover ?? gallery[0];
const materialLine = materials || materialsEn || '';
const altText = [title, titleEn, materialLine].filter(Boolean).join(' · ');
---

<article class={`piece${featured ? ' piece--featured reveal' : ' reveal'}`} style={`--i:${index}`}>
  <div class="piece__frame">
    {
      lead ? (
        <Picture
          src={lead}
          alt={altText}
          formats={['avif', 'webp']}
          widths={[400, 640, 900, 1280, 1600, 2200]}
          sizes={featured
            ? '(max-width: 560px) 92vw, (max-width: 1024px) 94vw, 66vw'
            : '(max-width: 560px) 92vw, (max-width: 1024px) 46vw, 31vw'}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding={priority ? 'sync' : 'async'}
        />
      ) : (
        <div class="piece__placeholder">
          <span>{title}</span>
        </div>
      )
    }
  </div>

  <div class="piece__meta">
    <div class="piece__heading">
      <h3 class="piece__title">{title}</h3>
      {titleEn && <p class="piece__title-en">{titleEn}</p>}
    </div>

    <div class="piece__details tnum">
      {year && <span>{year}</span>}
      {materials && <span>{materials}</span>}
      {!materials && materialsEn && <span>{materialsEn}</span>}
      {dimensions && <span class="piece__dims">{dimensions}</span>}
    </div>

    {
      description && (
        <p class="piece__desc">
          {description}
          {descriptionEn && <span class="piece__desc-en">{descriptionEn}</span>}
        </p>
      )
    }
  </div>
</article>

<style>
  .piece {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }

  .piece__frame {
    position: relative;
    overflow: hidden;
    background: var(--bg-raised);
    border-radius: 2px;
  }

  .piece__frame :global(picture) {
    display: block;
  }

  .piece__frame :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 1.05s var(--ease-out), filter 0.6s var(--ease);
    filter: saturate(0.92);
  }

  .piece:hover .piece__frame :global(img) {
    transform: scale(1.035);
    filter: saturate(1);
  }

  .piece__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    background: linear-gradient(135deg, var(--bg-hover) 0%, var(--bg-raised) 100%);
    border: 1px dashed var(--line);
    color: var(--text-faint);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .piece__meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .piece__heading {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .piece__title {
    margin: 0;
    font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.4;
    color: var(--text);
  }

  .piece--featured .piece__title {
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
  }

  .piece__title-en {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-faint);
    line-height: 1.4;
  }

  .piece__details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    font-size: 0.6875rem;
    color: var(--text-faint);
    letter-spacing: 0.03em;
  }

  .piece__dims {
    font-variant-numeric: tabular-nums;
  }

  .piece__desc {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-dim);
    max-width: 52ch;
  }

  .piece__desc-en {
    display: block;
    margin-top: 0.3em;
    font-size: 0.92em;
    color: var(--text-faint);
  }
</style>
