---
/**
 * About — work experience and selected projects.
 *
 * Two-column editorial layout: a sticky left column carrying the heading and
 * intro, a scrolling right column with the two lists. On narrow screens it
 * collapses to a single column.
 */
import { ABOUT, EXPERIENCE, PROJECTS, UI } from '../lib/site';
---

<section
  id="about"
  data-section="about"
  class="about"
  aria-labelledby="about-heading"
>
  <div class="shell about__inner">
    <!-- ---- Left: heading + intro ---- -->
    <div class="about__lede">
      <div class="about__headline reveal">
        <span class="eyebrow about__numeral">{ABOUT.numeral}</span>
        <div class="about__titles">
          <h2 class="about__title" id="about-heading">{ABOUT.heading.zh}</h2>
          <span class="about__title-en">{ABOUT.heading.en}</span>
        </div>
        <span class="accent-rule" aria-hidden="true" />
      </div>

      <p class="about__intro reveal">
        {ABOUT.intro.zh}
        <span class="about__intro-en">{ABOUT.intro.en}</span>
      </p>

      <blockquote class="about__quote reveal" aria-label="Design philosophy">
        <span class="about__quote-mark" aria-hidden="true">“</span>
        <p>{ABOUT.quote.zh}</p>
      </blockquote>
    </div>

    <!-- ---- Right: experience + projects ---- -->
    <div class="about__body">
      <!-- Experience -->
      <div class="block reveal">
        <h3 class="block__label">
          <span>{ABOUT.experienceLabel.zh}</span>
          <span class="block__label-en">{ABOUT.experienceLabel.en}</span>
        </h3>

        <ol class="timeline">
          {
            EXPERIENCE.map((job) => (
              <li class="job">
                <div class="job__period tnum">{job.period}</div>

                <div class="job__main">
                  <div class="job__head">
                    <h4 class="job__role">{job.role.zh}</h4>
                    <span class="job__role-en">{job.role.en}</span>
                  </div>

                  <div class="job__meta">
                    <span class="job__company">{job.company.zh}</span>
                    <span class="job__company-en">{job.company.en}</span>
                    <span class="job__dot" aria-hidden="true">·</span>
                    <span class="job__location">
                      {job.location.zh} / {job.location.en}
                    </span>
                  </div>

                  {job.summary && (
                    <p class="job__summary">
                      {job.summary.zh}
                      <span class="job__summary-en">{job.summary.en}</span>
                    </p>
                  )}

                  {job.highlights && job.highlights.length > 0 && (
                    <ul class="job__points">
                      {job.highlights.map((h) => (
                        <li>
                          {h.zh}
                          <span class="job__point-en">{h.en}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Projects -->
      <div class="block reveal">
        <h3 class="block__label">
          <span>{ABOUT.projectsLabel.zh}</span>
          <span class="block__label-en">{ABOUT.projectsLabel.en}</span>
        </h3>

        <ul class="projects">
          {
            PROJECTS.map((p) => (
              <li class="project">
                <span class="project__year tnum">{p.year}</span>

                <div class="project__main">
                  <div class="project__name">
                    {p.name.zh}
                    <span class="project__name-en">{p.name.en}</span>
                  </div>
                  <div class="project__scope">
                    {p.scope.zh}
                    <span class="project__scope-en">{p.scope.en}</span>
                  </div>
                </div>

                <div class="project__aside">
                  <span class="project__client">{p.client.zh}</span>
                  <span class="project__role">
                    {p.role.zh}
                    <span class="project__role-en">{p.role.en}</span>
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    border-top: 1px solid var(--line-soft);
  }

  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  /* ---- Left column ---- */
  .about__lede {
    position: sticky;
    top: calc(var(--nav-h, 4rem) + 2rem);
  }

  .about__headline {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 1.75rem;
  }

  .about__numeral {
    color: var(--accent);
    opacity: 0.65;
    font-size: 0.5625rem;
  }

  .about__titles {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .about__title {
    margin: 0;
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: 0.01em;
  }

  .about__title-en {
    font-size: clamp(0.5625rem, 0.9vw, 0.6875rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
  }

  .about__headline .accent-rule {
    align-self: center;
    margin-inline-start: 0.3rem;
  }

  .about__intro {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--text-dim);
    max-width: 38ch;
  }

  .about__intro-en {
    display: block;
    margin-top: 0.9rem;
    font-size: 0.9em;
    line-height: 1.7;
    color: var(--text-faint);
  }

  .about__quote {
    margin: 2.5rem 0 0;
    padding: 1.5rem 0 0 1.5rem;
    border-left: 1px solid var(--accent);
    color: var(--text);
  }

  .about__quote p {
    margin: 0;
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.01em;
  }

  .about__quote-mark {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.6;
    font-family: Georgia, serif;
  }

  /* ---- Right column ---- */
  .about__body {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
    min-width: 0;
  }

  .block__label {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin: 0 0 1.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--text);
  }

  .block__label-en {
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* ---- Experience timeline ---- */
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .job {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 1.5rem;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .job:first-child {
    padding-block-start: 0;
  }

  .job:last-child {
    border-bottom: none;
    padding-block-end: 0;
  }

  .job__period {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    padding-top: 0.15rem;
  }

  .job__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .job__role {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--text);
    line-height: 1.4;
  }

  .job__role-en {
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .job__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 0.3rem;
    font-size: 0.6875rem;
    color: var(--text-dim);
  }

  .job__company-en {
    font-size: 0.9em;
    color: var(--text-faint);
  }

  .job__dot {
    opacity: 0.4;
  }

  .job__location {
    color: var(--text-faint);
  }

  .job__summary {
    margin: 0.65rem 0 0;
    font-size: 0.75rem;
    line-height: 1.75;
    color: var(--text-dim);
    max-width: 56ch;
  }

  .job__summary-en {
    display: block;
    margin-top: 0.3em;
    font-size: 0.92em;
    color: var(--text-faint);
  }

  .job__points {
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    max-width: 56ch;
  }

  .job__points li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.75rem;
    line-height: 1.65;
    color: var(--text-dim);
  }

  .job__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 4px;
    height: 1px;
    background: var(--text-faint);
  }

  .job__point-en {
    display: block;
    margin-top: 0.2em;
    font-size: 0.92em;
    color: var(--text-faint);
  }

  /* ---- Projects ---- */
  .projects {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .project {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 11rem);
    gap: 0 1.25rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--line-soft);
    align-items: baseline;
  }

  .project:first-child {
    padding-block-start: 0;
  }

  .project:last-child {
    border-bottom: none;
    padding-block-end: 0;
  }

  .project__year {
    font-size: 0.6875rem;
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }

  .project__main {
    min-width: 0;
  }

  .project__name {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.45;
  }

  .project__name-en {
    display: block;
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-top: 0.1rem;
  }

  .project__scope {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .project__scope-en {
    display: block;
    margin-top: 0.15em;
    font-size: 0.92em;
    color: var(--text-faint);
  }

  .project__aside {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: right;
  }

  .project__client {
    font-size: 0.6875rem;
    color: var(--text-dim);
  }

  .project__role {
    font-size: 0.6875rem;
    color: var(--text-faint);
  }

  .project__role-en {
    display: block;
    font-size: 0.85em;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .about__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .about__lede {
      position: static;
    }
    .about__intro {
      max-width: 52ch;
    }
  }

  @media (max-width: 620px) {
    .job {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }
    .job__period {
      padding-top: 0;
    }
    .project {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0 0.75rem;
    }
    .project__aside {
      grid-column: 2;
      flex-direction: row;
      gap: 0.6rem;
      text-align: left;
      margin-top: 0.35rem;
    }
    .project__role-en {
      display: inline;
      margin-left: 0.3em;
    }
  }
</style>
