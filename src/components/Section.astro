---
/**
 * One category = one anchored section with a bilingual heading and a grid.
 */
import Piece from './Piece.astro';
import type { CollectionEntry } from 'astro:content';
import type { Bi } from '../lib/site';
import { UI } from '../lib/site';

interface Props {
  slug: string;
  label: Bi;
  numeral: string;
  blurb: Bi;
  items: CollectionEntry<'work'>[];
  index: number;
}

const { slug, label, numeral, blurb, items, index } = Astro.props;
const count = String(items.length).padStart(2, '0');

// The first featured item in this section gets a wider tile.
const featuredIndex = items.findIndex((i) => i.data.featured);
---

<section
  id={slug}
  data-section={slug}
  class="section"
  aria-labelledby={`${slug}-heading`}
>
  <div class="shell">
    <div class="section__head">
      <div class="section__headline reveal">
        <span class="section__numeral">{numeral}</span>
        <div class="section__titles">
          <h2 class="section__title" id={`${slug}-heading`}>{label.zh}</h2>
          <span class="section__title-en">{label.en}</span>
        </div>
        <span class="accent-rule" aria-hidden="true" />
      </div>

      <div class="section__aside reveal">
        <p class="section__blurb">
          {blurb.zh}
          <span class="section__blurb-en">{blurb.en}</span>
        </p>
        <span class="section__count tnum">
          {count} <small>{UI.pieces.zh} / {UI.pieces.en}</small>
        </span>
      </div>
    </div>

    {
      items.length > 0 ? (
        <div class={`grid${featuredIndex >= 0 ? ' grid--featured' : ''}`}>
          {items.map((item, i) => (
            <Piece
              item={item}
              index={i}
              priority={index === 0 && i === 0}
              featured={i === featuredIndex}
            />
          ))}
        </div>
      ) : (
        <p class="empty">
          {UI.empty.zh} <span>{UI.empty.en}</span>
        </p>
      )
    }
  </div>
</section>

<style>
  .section {
    padding-block: clamp(4rem, 8vw, 7.5rem);
    border-top: 1px solid var(--line-soft);
  }

  .section:first-of-type {
    border-top: none;
  }

  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.25rem, 4.5vw, 3.75rem);
    flex-wrap: wrap;
  }

  .section__headline {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }

  .section__numeral {
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
  }

  .section__titles {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .section__title {
    margin: 0;
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: 0.01em;
  }

  .section__title-en {
    font-size: clamp(0.5625rem, 0.9vw, 0.6875rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
  }

  .section__headline .accent-rule {
    align-self: center;
    margin-inline-start: 0.4rem;
  }

  .section__aside {
    display: flex;
    align-items: baseline;
    gap: 1.75rem;
    max-width: 38ch;
  }

  .section__blurb {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--text-dim);
  }

  .section__blurb-en {
    display: block;
    margin-top: 0.3em;
    font-size: 0.92em;
    color: var(--text-faint);
  }

  .section__count {
    flex-shrink: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    font-weight: 500;
  }

  .section__count small {
    font-size: 0.75em;
    letter-spacing: 0.04em;
    opacity: 0.8;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3.2vw, 2.75rem) clamp(1rem, 2.2vw, 2rem);
    align-items: start;
  }

  /* Featured tile spans two columns on desktop. */
  .grid--featured > :global(.piece--featured) {
    grid-column: span 2;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .grid--featured > :global(.piece--featured) {
      grid-column: span 2;
    }
  }

  @media (max-width: 780px) {
    .section__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .section__headline {
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
    }
    .section__titles {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
    .section__title {
      font-size: clamp(2rem, 9.5vw, 3.25rem);
      line-height: 0.92;
    }
    .section__title-en {
      font-size: 0.625rem;
      letter-spacing: 0.2em;
      opacity: 0.8;
    }
    .section__headline .accent-rule {
      display: none;
    }
    .section__aside {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      max-width: 52ch;
    }
    .section__blurb {
      font-size: 0.875rem;
      line-height: 1.6;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .grid--featured > :global(.piece--featured) {
      grid-column: span 1;
    }
  }

  .empty {
    margin: 0;
    padding: 2.5rem;
    border: 1px dashed var(--line);
    border-radius: 2px;
    color: var(--text-faint);
    font-size: 0.8125rem;
    text-align: center;
  }

  .empty span {
    display: block;
    margin-top: 0.3em;
    font-size: 0.85em;
    opacity: 0.75;
  }
</style>
